# Copy this file to .env and fill in your credentials
# cp .env.example .env

# ConnectWise portal URL (the base URL you log into)
CW_URL=https://your-cw-instance.connectwise.com

# ConnectWise login credentials
CW_USERNAME=your.username@carolinaday.org
CW_PASSWORD=your_password_here

# Dashboard password — the one people type on the sign-in screen.
# It is checked by the server only and is never sent to the browser.
# REQUIRED: the dashboard stays locked until this is set. Use a long, unique passphrase.
DASHBOARD_PASSWORD=

# Optional extra secret mixed into the session-cookie signature. Changing it (or the
# password) signs everyone out.
SESSION_SECRET=

# Server port (default: 3000)
PORT=3000

# ── Supabase (persistent storage) ────────────────────────────────────────────
# Create a free project at supabase.com, then get these from Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── HappyFox API (optional — replaces the manual CSV upload) ─────────────────
# In HappyFox: Apps → Goodies → API → Enable, then "+" to add a key.
# Hover over the new key and click "see auth code" to get both values.
# HF_ACCOUNT is the first part of your HappyFox address ("carolinaday" for
# carolinaday.happyfox.com). EU-hosted accounts: use the full URL, e.g. https://school.happyfox.net
HF_ACCOUNT=
HF_API_KEY=
HF_AUTH_CODE=

# ── Microsoft Teams (Graph API) ───────────────────────────────────────────────
# Azure AD app registration credentials (from portal.azure.com)
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Teams chat ID to pull messages from (group chat or 1:1)
# Get it from Teams web: open the chat, copy the URL — the chat ID is the long string
# after /conversations/ that looks like: 19:xxxxxxxx_xxxxxxxx@unq.gbl.spaces
# Or use Graph Explorer: GET https://graph.microsoft.com/v1.0/me/chats
TEAMS_CHAT_ID=19:your-chat-id-here@unq.gbl.spaces

# ── Automation (optional) ─────────────────────────────────────────────────────
# Re-sync ConnectWise, HappyFox (if the API is configured) and Teams every N hours while the server runs.
# Leave unset (or 0) to sync only when someone presses the buttons.
AUTO_SYNC_HOURS=6

# If the host sleeps when idle (e.g. Render free tier), timers pause too. Instead, have a
# scheduled job call:  POST https://your-dashboard/api/sync-all
# Set a secret here and send it as the "x-cron-secret" header so only your job can trigger it.
CRON_SECRET=

# Time zone used to date the daily history snapshots (default America/New_York)
DASHBOARD_TZ=America/New_York
